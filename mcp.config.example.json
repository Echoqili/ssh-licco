{
  "mcpServers": {
    "ssh-licco": {
      "command": "ssh-licco",
      "env": {
        "SSH_HOST": "your-server-ip",
        "SSH_PORT": "22",
        "SSH_USER": "your-username",
        "SSH_PASSWORD": "your-password",
        "SSH_SECURITY_LEVEL": "balanced",
        "SSH_EXTRA_ALLOWED_COMMANDS": "git,docker,npm,pip",
        "SSH_BASE_DIR": "/home",
        "SSH_RATE_LIMIT": "true",
        "SSH_RATE_LIMIT_MAX": "30",
        "SSH_RATE_LIMIT_WINDOW": "60"
      }
    }
  }
}
